programa
{
    funcao inicio()
    {
        inteiro numero

        escreva("Digite um número inteiro: ")
        leia(numero)

        se (numero % 2 == 0)
        {
            escreva("\n ====== O número é par ======")
        }
        senao
        {
            escreva("\n ====== O número é ímpar ======")
        }
    }
}

